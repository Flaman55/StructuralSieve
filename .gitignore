/.lake/
/build/
/lake-packages/
*.olean
*.ilean
*.trace

# Dependency-graph intermediates (regenerate with scripts/dependency_graph.py).
# The committed artifacts are docs/dependency_graph.svg and .pdf.
*.gv
*.gexf
docs/dependency_graph
docs/dependency_graph.png

# Python
__pycache__/
*.pyc

# Editor / OS
.DS_Store
*.swp
.vscode/
.idea/

# VS Code multi-root workspace files
*.code-workspace

# Palomar local preflight: cloned lean4export/comparator toolchains (with
# their own nested .git dirs), build artifacts, and run reports/logs.
# Never commit — regenerated per machine/OS by scripts/palomar_preflight.sh.
/.cache/palomar-comparator/
/.cache/palomar-editorial/
